<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <!-- NAVEGACION INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNavInicioControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Inicio"
            android:textColor="#777783"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnNavControlControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Control"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNavAmbienteControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ambiente"
            android:textColor="#777783"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnNavPerfilControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Perfil"
            android:textColor="#777783"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- CONTENIDO SIN SCROLL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- ENCABEZADO -->
        <TextView
            android:id="@+id/tvTituloControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control del techo"
            android:textColor="#202124"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="16dp"
            android:text="Gestiona la apertura de forma inteligente"
            android:textColor="#777783"
            android:textSize="13sp" />

        <!-- ESTADO DEL TECHO -->
        <LinearLayout
            android:id="@+id/cardEstadoTecho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO ACTUAL"
                    android:textColor="#777783"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstadoTecho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Desconocido"
                    android:textColor="#202124"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescripcionEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Esperando respuesta del dispositivo"
                    android:textColor="#777783"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvConexionEsp32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF0F0"
                android:padding="8dp"
                android:text="Desconectado"
                android:textColor="#C62828"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONTROLES RAPIDOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Control rápido"
            android:textColor="#202124"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAbrirTecho"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:text="ABRIR"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCerrarTecho"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp"
                android:text="CERRAR"
                android:textColor="#34343D"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- APERTURA PERSONALIZADA -->
        <LinearLayout
            android:id="@+id/cardControlApertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apertura personalizada"
                android:textColor="#202124"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ajusta el porcentaje de apertura"
                android:textColor="#777783"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPorcentajeApertura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="0%"
                android:textColor="#2563EB"
                android:textSize="30sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbApertura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cerrado · 0%"
                    android:textColor="#777783"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abierto · 100%"
                    android:textColor="#777783"
                    android:textSize="11sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAplicarApertura"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#2563EB"
                android:text="Aplicar apertura"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MODO MANUAL -->
        <LinearLayout
            android:id="@+id/cardModoManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modo manual"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Control directo desde la aplicación"
                    android:textColor="#777783"
                    android:textSize="11sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/switchModoManual"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>